{
  "name": "sling-builder-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm build:sw && next build",
    "build:sw": "esbuild src/sw/sw.ts --bundle --minify --outfile=public/sw.js --target=es2020 --define:process.env.NODE_ENV=\\\"production\\\"",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx seed/run.ts",
    "import:prototype": "tsx seed/import-prototype.ts",
    "worker": "tsx worker/index.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "date-fns": "4.4.0",
    "dexie": "4.4.6",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.57.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "nodemailer": "10.1.1",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "pino": "10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "serwist": "9.5.13",
    "uuidv7": "^1.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "18.0.8",
    "drizzle-kit": "0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@10.28.0"
}
