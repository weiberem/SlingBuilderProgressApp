# Sling Builder Tracker – Umgebungsvariablen. Kopieren nach .env (wird nie committet).
# Docker Compose liest diese Datei automatisch; lokal ohne Docker lesen die Skripte sie über dotenv.

# --- Datenbank ---------------------------------------------------------------
# Lokal ohne Docker: eigene PostgreSQL-16-Instanz. Mit Docker Compose wird DATABASE_URL
# ignoriert und aus POSTGRES_* gebildet (Host "db").
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sling_dev
POSTGRES_USER=sling
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_DB=sling

# --- App ---------------------------------------------------------------------
# Öffentliche URL (Links in Mails, OAuth-Callbacks). Mit Caddy: https://<DOMAIN>
APP_URL=http://localhost:3000
# 32 Bytes base64, z. B. `openssl rand -base64 32`. Verschlüsselt Integrations-Tokens. Nie ändern,
# sonst sind gespeicherte Tokens unlesbar.
APP_ENCRYPTION_KEY=
LOG_LEVEL=info

# --- Erster Nutzer (pnpm seed) ---------------------------------------------------
SEED_ADMIN_EMAIL=remy.weibel@gmail.com
SEED_ADMIN_PASSWORD=change-me-now
SEED_ADMIN_NAME=Remy Weibel

# --- Mail (Passwort-Reset, Verifizierung) ------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Sling Builder Tracker <noreply@example.ch>

# --- Betrieb mit Docker Compose (docs/betrieb.md) ------------------------------
# Domain für Caddy (automatisches TLS). Leer lassen → http://localhost ohne TLS.
DOMAIN=
TZ=Europe/Zurich
# Backup: Cron-Ausdruck (Zeitzone TZ), Aufbewahrung in Tagen, optionales rclone-Ziel.
BACKUP_CRON=30 3 * * *
BACKUP_KEEP_DAYS=30
BACKUP_ON_START=0
RCLONE_REMOTE=
RCLONE_CONFIG_DIR=./docker/rclone

# --- Tests -------------------------------------------------------------------
# Vitest leert diese Datenbank bei jedem Lauf. Nie die Entwicklungsdatenbank eintragen.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/sling_test
# Playwright (pnpm test:e2e): Zugangsdaten, sonst SEED_ADMIN_*; E2E_REGISTRATION optional.
E2E_EMAIL=
E2E_PASSWORD=
E2E_REGISTRATION=
